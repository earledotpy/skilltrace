# Python build / editable-install artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Derived, disposable data (invariant / decision 12): never read back by the engine
data/

# Timestamped backup archives (issue #38): the one artifact meant to outlive
# an accidental repo delete, deliberately not under data/ (which means "safe
# to delete"). No pruning; deleting an archive is a human act.
backups/

# Learner-produced solution artifacts for objective-gated nodes and local
# study demonstration artifacts. The shipped seed carries no solutions or
# study scratch, only checkers. Keeping this untracked stops local artifacts
# from landing in the curriculum.
evidence/artifacts/*

